{
  "name": "id4me-scraper",
  "version": "2.4.4",
  "description": "ID4Me Automation Tool",
  "main": "main.js",
  "author": "Flowza IQ",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "test": "node tests/absentee.test.js && node tests/date.test.js && node tests/network.test.js && node tests/address.test.js"
  },
  "build": {
    "appId": "com.yourname.id4me-scraper",
    "productName": "ID4Me Scraper",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "FlowzaIQ",
      "repo": "iD4me-Finder"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/favicon2.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "ID4Me-Scraper-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "electron-updater": "^6.8.3",
    "googleapis": "^171.4.0",
    "playwright": "^1.42.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1"
  }
}
